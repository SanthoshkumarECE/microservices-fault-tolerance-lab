# Maven build output (every module's target/ dir - compiled classes, jars, test reports)
target/
**/target/

# IntelliJ IDEA project files (machine-specific, regenerated automatically)
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse (in case anyone opens it there)
.classpath
.project
.settings/
bin/

# VS Code
.vscode/

# OS-generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment-specific overrides you might create later
# (e.g. application-local.yml for personal port/URL tweaks)
application-local.yml
application-local.properties

# Compiled class files, if ever generated outside target/
*.class